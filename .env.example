# ── Wren configuration ────────────────────────────────────────────────────────
# Copy to .env and adjust. Everything else is configured in the admin panel.

# Public URL users (and provider webhooks) reach Wren at. Used for inbound webhook URLs and invite links.
PUBLIC_URL=https://mail.example.com

# Encrypts provider credentials and signs tokens. Generate with: openssl rand -base64 32
# If unset, one is generated in DATA_DIR/.secret — back it up either way.
WREN_SECRET=

# HTTP server
PORT=3000
HOST=0.0.0.0
# Set to true when behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=true

# Where the SQLite database and message store live.
DATA_DIR=/data

# ── Built-in SMTP (receiving) ────────────────────────────────────────────────
# Accepts mail for your hosted domains when MX points at this server. Not needed if
# you only receive through provider webhooks (Cloudflare, Resend, Postmark…).
SMTP_ENABLED=true
SMTP_PORT=2525
# Hostname announced in the SMTP banner and suggested as your MX target.
SMTP_HOSTNAME=mx.example.com
# PEM files for STARTTLS (strongly recommended on the public internet).
SMTP_TLS_KEY=
SMTP_TLS_CERT=
SMTP_MAX_SIZE_MB=50

# Authenticated submission for desktop/mobile mail apps (0 = off). Use your password, or an API key if 2FA is on.
SUBMISSION_PORT=0

# Optional
# LOG_LEVEL=info
# DNS_SERVERS=1.1.1.1,8.8.8.8
